+// sglangParser decodes the tagged msgspec structs emitted by SGLang.
+type sglangParser struct{}
+
+func (p *sglangParser) Source() string { return SourceSGLang }
+
+func (p *sglangParser) EventMappings() map[string]EventType {
+	return map[string]EventType{
+		"BlockStored":      EventTypeBlockStored,
+		"BlockRemoved":     EventTypeBlockRemoved,
+		"AllBlocksCleared": EventTypeAllCleared,
+	}
+}
+
+func (p *sglangParser) ParseEvent(raw []interface{}, timestamp interface{}) (KVEvent, error) {
+	if len(raw) == 0 {
+		return nil, fmt.Errorf("empty SGLang event")
+	}
+
+	eventTypeStr, ok := raw[0].(string)
+	if !ok {
+		return nil, fmt.Errorf("invalid SGLang event type format: %T", raw[0])
+	}
+
+	switch p.EventMappings()[eventTypeStr] {
+	case EventTypeBlockStored:
+		return parseSGLangBlockStored(raw, timestamp)
+	case EventTypeBlockRemoved:
+		return parseSGLangBlockRemoved(raw, timestamp)
+	case EventTypeAllCleared:
+		return parseSGLangAllCleared(raw, timestamp)
+	default:
+		return nil, fmt.Errorf("unknown SGLang event type: %s", eventTypeStr)
+	}
+}
+
+func DecodeSGLangEventBatch(data []byte) (*EventBatch, error) {
+	var arr []interface{}
+	if err := msgpack.Unmarshal(data, &arr); err != nil {
+		return nil, fmt.Errorf("failed to unmarshal SGLang event batch: %w", err)
+	}
+	if len(arr) != 3 {
+		return nil, fmt.Errorf("expected 3-element SGLang batch, got %d", len(arr))
+	}
+	events, ok := arr[1].([]interface{})
+	if !ok {
+		return nil, fmt.Errorf("invalid SGLang events type: %T", arr[1])
+	}
+	dpRank, err := parseInt64(arr[2])
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse SGLang dpRank: %w", err)
+	}
+	batch := &EventBatch{
+		Source:           SourceSGLang,
+		Events:           make([]KVEvent, 0, len(events)),
+		DataParallelRank: dpRank,
+	}
+	for index, rawEvent := range events {
+		if tagged, ok := normalizeTaggedMap(rawEvent); ok {
+			event, err := parseTaggedSGLangEvent(tagged, arr[0])
+			if err != nil {
+				return nil, fmt.Errorf("failed to parse tagged SGLang event at index %d: %w", index, err)
+			}
+			batch.Events = append(batch.Events, event)
+			continue
+		}
+		eventSlice, ok := rawEvent.([]interface{})
+		if !ok {
+			return nil, fmt.Errorf("SGLang event at index %d is neither tagged map nor array: %T", index, rawEvent)
+		}
+		event, err := (&sglangParser{}).ParseEvent(eventSlice, arr[0])
+		if err != nil {
+			return nil, fmt.Errorf("failed to parse array SGLang event at index %d: %w", index, err)
+		}
+		batch.Events = append(batch.Events, event)
+	}
+	return batch, nil
+}
+
+func normalizeTaggedMap(raw interface{}) (map[string]interface{}, bool) {
+	switch value := raw.(type) {
+	case map[string]interface{}:
+		return value, true
+	case map[interface{}]interface{}:
+		result := make(map[string]interface{}, len(value))
+		for key, fieldValue := range value {
+			stringKey, ok := key.(string)
+			if !ok {
+				return nil, false
+			}
+			result[stringKey] = fieldValue
+		}
+		return result, true
+	default:
+		return nil, false
+	}
+}
+
+func parseTaggedSGLangEvent(data map[string]interface{}, timestamp interface{}) (KVEvent, error) {
+	eventType, err := safeGetString(data["type"])
+	if err != nil {
+		return nil, fmt.Errorf("parse SGLang tagged event type: %w", err)
+	}
+	switch eventType {
+	case "BlockStored":
+		event := &BlockStoredEvent{Type: EventTypeBlockStored, Medium: "GPU"}
+		if event.Timestamp, err = parseTimestamp(timestamp); err != nil {
+			return nil, err
+		}
+		if event.BlockHashes, err = parseUint64Array(data["block_hashes"]); err != nil {
+			return nil, fmt.Errorf("parse block_hashes: %w", err)
+		}
+		if parentHash, exists := data["parent_block_hash"]; exists && parentHash != nil {
+			if event.ParentBlockHash, err = parseUint64(parentHash); err != nil {
+				return nil, fmt.Errorf("parse parent_block_hash: %w", err)
+			}
+		}
+		if event.TokenIDs, err = parseInt32Array(data["token_ids"]); err != nil {
+			return nil, fmt.Errorf("parse token_ids: %w", err)
+		}
+		if event.BlockSize, err = parseInt64(data["block_size"]); err != nil {
+			return nil, fmt.Errorf("parse block_size: %w", err)
+		}
+		if loraID, exists := data["lora_id"]; exists && loraID != nil {
+			if event.LoraID, err = parseInt64(loraID); err != nil {
+				return nil, fmt.Errorf("parse lora_id: %w", err)
+			}
+		}
+		if medium, exists := data["medium"]; exists && medium != nil {
+			if event.Medium, err = safeGetString(medium); err != nil {
+				return nil, fmt.Errorf("parse medium: %w", err)
+			}
+		}
+		if cacheSalt, exists := data["cache_salt"]; exists && cacheSalt != nil {
+			if event.CacheSalt, err = safeGetString(cacheSalt); err != nil {
+				return nil, fmt.Errorf("parse cache_salt: %w", err)
+			}
+		}
+		if sessionID, exists := data["session_id"]; exists && sessionID != nil {
+			if event.SessionID, err = safeGetString(sessionID); err != nil {
+				return nil, fmt.Errorf("parse session_id: %w", err)
+			}
+		}
+		return event, nil
+	case "BlockRemoved":
+		event := &BlockRemovedEvent{Type: EventTypeBlockRemoved, Medium: "GPU"}
+		if event.Timestamp, err = parseTimestamp(timestamp); err != nil {
+			return nil, err
+		}
+		if event.BlockHashes, err = parseUint64Array(data["block_hashes"]); err != nil {
+			return nil, fmt.Errorf("parse block_hashes: %w", err)
+		}
+		if medium, exists := data["medium"]; exists && medium != nil {
+			if event.Medium, err = safeGetString(medium); err != nil {
+				return nil, fmt.Errorf("parse medium: %w", err)
+			}
+		}
+		return event, nil
+	case "AllBlocksCleared":
+		event := &AllBlocksClearedEvent{Type: EventTypeAllCleared}
+		if event.Timestamp, err = parseTimestamp(timestamp); err != nil {
+			return nil, err
+		}
+		return event, nil
+	default:
+		return nil, fmt.Errorf("unknown SGLang tagged event type: %s", eventType)
+	}
+}
