+func TestDynamicCacheSaltIsolationRemoveAndClear(t *testing.T) {
+	m := NewEventManager([]common.ServiceConfig{}, 0)
+	handler := &KVEventHandler{
+		manager:    m,
+		blockSize:  4,
+		modelName:  "test-model",
+		loraName:   "",
+		tenant_id:  "tenant-a",
+		instanceID: "test-instance",
+	}
+	tokens := []int32{1, 2, 3, 4}
+	store := func(hash uint64, cacheSalt string) {
+		t.Helper()
+		if err := handler.HandleEvent(&zmq.BlockStoredEvent{
+			BlockSize:   4,
+			BlockHashes: []uint64{hash},
+			TokenIDs:    tokens,
+			Medium:      "GPU",
+			CacheSalt:   cacheSalt,
+		}, 0); err != nil {
+			t.Fatalf("store %s: %v", cacheSalt, err)
+		}
+	}
+	query := func(cacheSalt string) int64 {
+		return m.getIndexer().CacheHitCompute(&prefixindex.ModelContext{
+			TenantID:       "tenant-a",
+			ModelName:      "test-model",
+			BlockSize:      4,
+			AdditionalSalt: cacheSalt,
+			InstanceID:     "test-instance",
+		}, tokens).LongestMatchTokens
+	}
+
+	store(101, "policy-v10")
+	if got := query("policy-v10"); got != 4 {
+		t.Fatalf("same identity candidate = %d, want 4", got)
+	}
+	if got := query("policy-v11"); got != 0 {
+		t.Fatalf("wrong_identity_candidate = %d, want 0", got)
+	}
+
+	if err := handler.HandleEvent(&zmq.BlockRemovedEvent{BlockHashes: []uint64{101}, Medium: "GPU"}, 0); err != nil {
+		t.Fatalf("remove: %v", err)
+	}
+	if got := query("policy-v10"); got != 0 {
+		t.Fatalf("stale_location_candidate = %d, want 0", got)
+	}
+
+	store(102, "policy-v10")
+	store(103, "policy-v11")
+	if err := handler.HandleEvent(&zmq.AllBlocksClearedEvent{}, 0); err != nil {
+		t.Fatalf("clear: %v", err)
+	}
+	if got := query("policy-v10"); got != 0 {
+		t.Fatalf("clear left v10 candidate = %d, want 0", got)
+	}
+	if got := query("policy-v11"); got != 0 {
+		t.Fatalf("clear left v11 candidate = %d, want 0", got)
+	}
+}
