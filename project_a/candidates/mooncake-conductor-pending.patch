+// ClearInstance invalidates all indexed prefixes for a service instance. It is
+// used when an engine emits AllBlocksCleared and makes stale cache hits
+// impossible while the index lacks per-instance/per-DP replica bookkeeping.
+func (p *PrefixCacheTable) ClearInstance(modelName, loraName, tenantID, additionalSalt string, blockSize int64, instanceID string) {
+	if tenantID == "" {
+		tenantID = "default"
+	}
+	contextKey := ModelContext{
+		ModelName:      modelName,
+		LoraName:       loraName,
+		BlockSize:      blockSize,
+		TenantID:       tenantID,
+		AdditionalSalt: additionalSalt,
+		InstanceID:     instanceID,
+	}
+	if _, loaded := p.contextMap.LoadAndDelete(contextKey); loaded {
+		p.contextCount.Add(-1)
+		slog.Info("Cleared prefix cache index for instance", "instance_id", instanceID)
+	}
+}
+
+// ClearAllInstanceNamespaces removes every dynamic request namespace for an
+// instance. SGLang AllBlocksCleared carries no cache_salt, so keeping any one
+// namespace would make a stale location visible to a later shadow query.
+func (p *PrefixCacheTable) ClearAllInstanceNamespaces(modelName, loraName, tenantID string, blockSize int64, instanceID string) {
+	if tenantID == "" {
+		tenantID = "default"
+	}
+	p.contextMap.Range(func(key, _ interface{}) bool {
+		context := key.(ModelContext)
+		if context.ModelName == modelName &&
+			context.LoraName == loraName &&
+			context.TenantID == tenantID &&
+			context.BlockSize == blockSize &&
+			context.InstanceID == instanceID {
+			if _, loaded := p.contextMap.LoadAndDelete(context); loaded {
+				p.contextCount.Add(-1)
+			}
+		}
+		return true
+	})
+}
