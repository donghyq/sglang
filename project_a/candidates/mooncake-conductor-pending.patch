+func TestDecodeSGLangTaggedMsgspecEvents(t *testing.T) {
+	batch := []interface{}{
+		int64(1700000000),
+		[]interface{}{
+			map[string]interface{}{
+				"type":              "BlockStored",
+				"block_hashes":      []interface{}{uint64(42)},
+				"parent_block_hash": uint64(7),
+				"token_ids":         []interface{}{int32(1), int32(2)},
+				"block_size":        int64(2),
+				"medium":            "CPU_PINNED",
+				"cache_salt":        "policy-v10",
+				"session_id":        "request-a",
+			},
+			map[string]interface{}{
+				"type":         "BlockRemoved",
+				"block_hashes": []interface{}{uint64(42)},
+				"medium":       "EXTERNAL",
+			},
+			map[string]interface{}{"type": "AllBlocksCleared"},
+		},
+		int64(3),
+	}
+	data, err := msgpack.Marshal(batch)
+	if err != nil {
+		t.Fatalf("marshal tagged SGLang batch: %v", err)
+	}
+	decoded, err := zmq.DecodeSGLangEventBatch(data)
+	if err != nil {
+		t.Fatalf("DecodeSGLangEventBatch: %v", err)
+	}
+	if decoded.DataParallelRank != 3 || len(decoded.Events) != 3 {
+		t.Fatalf("unexpected decoded batch: %+v", decoded)
+	}
+	stored := decoded.Events[0].(*zmq.BlockStoredEvent)
+	if stored.Medium != "CPU_PINNED" || stored.CacheSalt != "policy-v10" || stored.SessionID != "request-a" {
+		t.Fatalf("tagged store fields lost: %+v", stored)
+	}
+	removed := decoded.Events[1].(*zmq.BlockRemovedEvent)
+	if removed.Medium != "EXTERNAL" || len(removed.BlockHashes) != 1 {
+		t.Fatalf("tagged remove fields lost: %+v", removed)
+	}
+	if _, ok := decoded.Events[2].(*zmq.AllBlocksClearedEvent); !ok {
+		t.Fatalf("expected tagged AllBlocksClearedEvent, got %T", decoded.Events[2])
+	}
+}
