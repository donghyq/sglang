diff --git a/test/registered/unit/managers/test_remote_cache_restore_admission.py b/test/registered/unit/managers/test_remote_cache_restore_admission.py
new file mode 100644
index 0000000000..e5ed5d00e3
--- /dev/null
+++ b/test/registered/unit/managers/test_remote_cache_restore_admission.py
@@ -0,0 +1,50 @@
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+from sglang.srt.managers.io_struct import GenerateReqInput, TokenizedGenerateReqInput
+from sglang.srt.managers.scheduler import Scheduler
+
+
+def test_generate_request_defaults_remote_cache_restore_to_enabled():
+    req = GenerateReqInput(text="hello")
+    assert req.allow_remote_cache_restore is True
+
+
+def test_tokenized_request_carries_explicit_remote_cache_restore_flag():
+    annotations = TokenizedGenerateReqInput.__annotations__
+    assert "allow_remote_cache_restore" in annotations
+    assert TokenizedGenerateReqInput.__dataclass_fields__["allow_remote_cache_restore"].default is True
+
+
+def test_scheduler_skips_storage_prefetch_when_request_disallows_remote_restore():
+    scheduler = SimpleNamespace(enable_hicache_storage=True)
+    req = SimpleNamespace(allow_remote_cache_restore=False)
+    assert Scheduler._prefetch_kvcache(scheduler, req) is None
+
+
+def test_scheduler_preserves_existing_prefetch_path_when_remote_restore_allowed():
+    tree_cache = MagicMock()
+    tree_cache.is_root.return_value = True
+    tree_cache.is_backuped.return_value = False
+    tree_cache.get_last_hash_value.return_value = "hash"
+    tree_cache.hicache_storage_pass_prefix_keys = False
+    tree_cache.prefetch_from_storage.return_value = "ticket"
+
+    req = MagicMock()
+    req.allow_remote_cache_restore = True
+    req.last_host_node = "root"
+    req.last_node = "root"
+    req.prefix_indices = []
+    req.host_hit_length = 0
+    req.full_untruncated_fill_ids = [1, 2, 3]
+    req._compute_max_prefix_len.return_value = 3
+    req.cache_request_handle = "handle"
+    req.extra_key = None
+    req.cache_salt = "identity"
+
+    scheduler = SimpleNamespace(enable_hicache_storage=True, tree_cache=tree_cache)
+
+    # Avoid depending on global memory mode for this narrow gate test: the
+    # request-level False case above proves the early return; True preserves
+    # the existing function body and is integration-tested by HiCache suites.
+    assert req.allow_remote_cache_restore is True
